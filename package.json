{
  "name": "vaultwright",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Client-side D&D 5e tools, starting with a dungeon generator, a from-scratch remake of donjon's classic tool.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "esbuild src/check/index.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/vaultwright/check.mjs && node node_modules/.cache/vaultwright/check.mjs",
    "preview": "vite preview",
    "start": "serve -s dist -l tcp://0.0.0.0:${PORT:-3000}"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serve": "^14.2.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
